# Python bytecode/cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Packaging/build artifacts
build/
dist/
*.egg-info/
.eggs/
*.zip
.package-repo-snapshot-version

# Virtual environments
.venv/
venv/
.env

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# OS/editor
.DS_Store
.vscode/
.idea/

# Project artifacts
results/*
!results/.gitkeep
paper/build/
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.bcf
paper/*.run.xml
paper/*.nav
paper/*.snm
paper/*.vrb
# The compiled paper itself stays tracked
!paper/main.pdf

# Local planning and agent-ticket material (kept on disk, not published)
/plan.md
/paper/outline.md
/paper/figure_plan.md
/paper/final_checklist.md

# Editor noise
*.swp
*.swo
.VSCodeCounter/

# Local secrets and credentials (keep only an explicit example file)
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.pypirc
credentials*.json
*secret*
*token*.txt

# Local agent, prompt, transcript and session state (any depth)
**/.codex/
**/.claude/
**/.cursor/
**/.aider*
**/.continue/
**/.specstory/
**/.windsurf/
/memory/
/prompts/
/skills/
